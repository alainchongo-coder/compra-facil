NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=$2a$12$replace-with-a-real-bcrypt-hash
# Optional: restrict CORS if a separate frontend is used
CORS_ORIGIN=
